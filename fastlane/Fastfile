# The release path, in one file, runnable from a laptop and from CI alike.
#
# ## What this does and does not own
#
# It does not build the project file — `xcodegen` does, and `bootstrap.sh` is the
# one command that puts a machine in a known state. It does not decide the
# version — `project.yml` does. What it owns is the part that needs credentials:
# signing, uploading, and refusing to do either when the repository is not clean.
#
# ## Why the build number comes from the run, not from a file
#
# A number committed to git means two branches racing to claim the same one, and
# a release that fails at upload because App Store Connect has seen it. The CI
# run number is monotonic and belongs to nobody, which is exactly what is wanted.
# Locally it falls back to the number of commits, for the same reason.

default_platform(:ios)

# Everything the lanes need from the outside, named once so a missing one fails
# **before** a twelve-minute build rather than after it.
REQUIRED_FOR_UPLOAD = %w[
  APP_STORE_CONNECT_KEY_ID
  APP_STORE_CONNECT_ISSUER_ID
  APP_STORE_CONNECT_KEY
  MATCH_PASSWORD
].freeze

platform :ios do
  before_all do
    ensure_git_status_clean unless ENV["CI"] == "true"
  end

  desc "Regenerate the project, then build and test — no credentials needed"
  lane :verify do
    sh("../Scripts/bootstrap.sh")
    sh("../Scripts/test.sh")
  end

  desc "Build a signed archive and send it to TestFlight"
  lane :beta do
    missing = REQUIRED_FOR_UPLOAD.select { |name| ENV[name].to_s.empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing: #{missing.join(', ')}.\n" \
        "See docs/testflight.md — these are secrets, and they are never stored " \
        "in this repository."
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # The generated project is not committed, so it may not exist at all on a
    # fresh runner — and if it does, it is stale by definition.
    sh("../Scripts/bootstrap.sh")

    match(api_key: api_key, type: "appstore", readonly: ENV["CI"] == "true")

    increment_build_number(
      xcodeproj: "Amissan.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || sh("git rev-list --count HEAD").strip
    )

    build_app(
      project: "Amissan.xcodeproj",
      scheme: "Amissan",
      configuration: "Release",
      export_method: "app-store",
      # The archive is written where the runner can pick it up as an artefact:
      # a build that failed to upload should still leave something to inspect.
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      # The upload waits, the processing does not: App Store Connect can take
      # half an hour, and a CI job idling through it buys nothing. The build
      # appears in TestFlight when Apple has finished with it.
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Refresh the signing certificates — run from a laptop, never from CI"
  lane :certificates do
    UI.user_error!("This lane creates signing material; CI is read-only.") if ENV["CI"] == "true"
    match(type: "appstore", readonly: false)
  end
end
