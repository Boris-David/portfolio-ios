{
  "sourceLanguage": "fr",
  "strings": {
    "journey.timeline.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`DateFormatter` is expensive to build and is not `Sendable`. Creating one per list cell is measurable while scrolling; here it lives in a value created once per screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`DateFormatter` est coûteux à construire et n'est pas `Sendable`. En créer un par cellule de liste se mesure au défilement ; ici il vit dans une valeur créée une fois par écran."
          }
        }
      }
    },
    "journey.timeline.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source serves **machine** dates: `start: \"2023-05\"`, `end: null`. It never serves “May 2023 → today”, and that is deliberate — the readable string depends on language, context and available width, and fixing it at the source would fix it for the site, the PDF résumé and this app at once.\n\nOne detail is not available directly: the **abbreviation period**. French already carries it (“janv.”), English does not (“Jan”), and “mai” like “May” take none since they are not abbreviated. Hence a single rule for both languages: *a short form that differs from the long form is an abbreviation, and an abbreviation takes a period.*\n\nIt is exactly the site's rule, which gets it from `Intl`. Both platforms therefore print the same string — not “roughly the same”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source sert des dates **machine** : `start: \"2023-05\"`, `end: null`. Elle ne sert jamais « mai 2023 → aujourd'hui », et c'est délibéré — la chaîne lisible dépend de la langue, du contexte et de la place, et la figer à la source la figerait pour le site, le CV en PDF et cette application à la fois.\n\nUn seul détail ne s'obtient pas directement : le **point d'abréviation**. Le français le porte déjà (« janv. »), l'anglais non (« Jan »), et « mai » comme « May » n'en prennent aucun puisqu'ils ne sont pas abrégés. D'où une règle unique pour les deux langues : *une forme courte qui diffère de la forme longue est une abréviation, et une abréviation prend un point.*\n\nC'est exactement la règle du site, qui l'obtient d'`Intl`. Les deux plateformes affichent donc la même chaîne — pas « à peu près la même »."
          }
        }
      }
    },
    "journey.timeline.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "twelve entries × two languages to maintain, and an abbreviation mistake only shows in production"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "douze entrées × deux langues à tenir, et une faute d'abréviation ne se voit qu'en production"
          }
        }
      }
    },
    "journey.timeline.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month table per language"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une table de mois par langue"
          }
        }
      }
    },
    "journey.timeline.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it would be the same for the PDF, the site and the app — and none of the three has the same room"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "elle deviendrait la même pour le PDF, le site et l'app — et aucun des trois n'a la même place"
          }
        }
      }
    },
    "journey.timeline.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serving a pre-formatted string from the API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servir la chaîne déjà formatée depuis l'API"
          }
        }
      }
    },
    "journey.timeline.rejected.3.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a `Date` carries a time and a zone: “May 2023” becomes April 2023 somewhere on the planet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "une `Date` porte une heure et un fuseau : « mai 2023 » devient avril 2023 quelque part sur la planète"
          }
        }
      }
    },
    "journey.timeline.rejected.3.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`Date` rather than `YearMonth`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`Date` plutôt que `YearMonth`"
          }
        }
      }
    },
    "journey.timeline.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns “2023-05” into “May 2023”, in the language on screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme « 2023-05 » en « mai 2023 », dans la langue affichée."
          }
        }
      }
    },
    "journey.timeline.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever a date is displayed: always through a localised formatter, never by concatenation. And in the model, the **coarsest** type that suffices — a graduation date has no need for seconds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès qu'une date doit s'afficher : toujours par un formateur localisé, jamais par concaténation. Et dans le modèle, le type le plus **grossier** qui suffise — une date de diplôme n'a pas besoin de secondes."
          }
        }
      }
    }
  },
  "version": "1.0"
}
