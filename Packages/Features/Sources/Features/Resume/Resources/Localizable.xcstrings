{
  "sourceLanguage": "fr",
  "strings": {
    "resume.pdf.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`autoScales` must be set **after** assigning the document: the other way round, PDFKit has no page to measure yet and the scale stays at 1 — the résumé then opens zoomed into the top-left corner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`autoScales` doit être posé **après** l'affectation du document : dans l'autre ordre, PDFKit n'a pas encore de page à mesurer et l'échelle reste à 1 — le CV s'ouvre alors zoomé au coin supérieur gauche."
          }
        }
      }
    },
    "resume.pdf.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The full chain, from API to screen:**\n\n1. the request carries the `ETag` of the version already known — `If-None-Match`;\n2. the server answers `304` when nothing changed: **not one byte of body** crosses the network, and we reopen the file already on disk;\n3. otherwise `200`, and `URLSession` writes the body to a temporary file — never into memory, a PDF has no business there;\n4. the **name** is read from `Content-Disposition`, not derived from the URL: the source decides what its document is called;\n5. the file is moved under that name into the cache, and that URL is what `PDFView` opens.\n\n`PDFView` takes a **URL**. Handing it bytes would work too and would load the whole document into memory; the URL lets PDFKit read only the pages being looked at."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**La chaîne complète, de l'API à l'écran :**\n\n1. la requête part avec l'`ETag` de la version déjà connue — `If-None-Match` ;\n2. le serveur répond `304` si rien n'a changé : **aucun octet de corps** ne traverse le réseau, et on rouvre le fichier déjà sur disque ;\n3. sinon `200`, et `URLSession` écrit le corps dans un fichier temporaire — jamais en mémoire, un PDF n'a pas à y passer ;\n4. le **nom** est lu dans `Content-Disposition`, pas déduit de l'URL : c'est la source qui décide comment son document s'appelle ;\n5. le fichier est déplacé sous ce nom dans le cache, et c'est cette URL que `PDFView` ouvre.\n\n`PDFView` prend une **URL**. Lui passer les octets marcherait aussi et chargerait tout le document en mémoire ; l'URL laisse PDFKit ne lire que les pages regardées."
          }
        }
      }
    },
    "resume.pdf.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "shows a PDF, but with no thumbnails, no reliable text selection, and a whole web engine embedded for it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "affiche un PDF, mais sans miniatures, sans sélection de texte fiable, et en embarquant un moteur web entier pour ça"
          }
        }
      }
    },
    "resume.pdf.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WKWebView"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WKWebView"
          }
        }
      }
    },
    "resume.pdf.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "two templates are two résumés that drift — and the one looked at least is the one that goes wrong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "deux gabarits, ce sont deux CV qui divergent — et c'est celui qu'on regarde le moins qui devient faux"
          }
        }
      }
    },
    "resume.pdf.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendering the résumé inside the app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre le CV dans l'application"
          }
        }
      }
    },
    "resume.pdf.rejected.3.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "presents full screen with its own bar: you lose sharing under the right name and the provenance line"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "présente en plein écran avec sa propre barre : on perd le partage au bon nom et l'indication de provenance"
          }
        }
      }
    },
    "resume.pdf.rejected.3.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickLook"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickLook"
          }
        }
      }
    },
    "resume.pdf.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the résumé, page by page, with native zoom and scrolling."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le CV, page par page, avec zoom et défilement natifs."
          }
        }
      }
    },
    "resume.pdf.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`PDFView` whenever it is a real PDF to read, annotate or search. `QuickLook` for a throwaway preview of any file type, with no integration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`PDFView` dès qu'il s'agit d'un vrai PDF qu'on veut lire, annoter ou chercher. `QuickLook` pour un aperçu jetable de n'importe quel type de fichier, sans intégration."
          }
        }
      }
    },
    "resume.share.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file shared from the `Caches` directory can be **purged by the system** between the share and the receiving app reading it. For a document meant to be kept, that is `Documents` — here it re-downloads, so the cache is the right place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier partagé depuis le répertoire `Caches` peut être **supprimé par le système** entre le partage et la lecture par l'application destinataire. Pour un document qu'on veut garder, c'est `Documents` — ici il se retélécharge, donc le cache est le bon endroit."
          }
        }
      }
    },
    "resume.share.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name comes from the response's `Content-Disposition` header, never from the URL. The website learned it the hard way: Safari on iOS **ignores** that header and names a share after the URL's last segment. Served at `/v1/cv/fr.pdf`, the résumé reached recipients named “fr”.\n\nThe fix landed on both sides: the API now serves `/v1/cv/amissan.ag-cv-fr.pdf` **and** the header. Here `ShareLink` gets a file URL, therefore a name — not an anonymous blob."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom vient de l'en-tête `Content-Disposition` de la réponse, jamais de l'URL. Le site l'a appris à ses dépens : Safari sur iOS **ignore** cet en-tête et nomme un partage d'après le dernier segment de l'URL. Servi sur `/v1/cv/fr.pdf`, le CV arrivait chez le destinataire sous le nom « fr ».\n\nLa correction a porté des deux côtés : l'API sert désormais `/v1/cv/amissan.ag-cv-fr.pdf` **et** l'en-tête. Ici, `ShareLink` reçoit une URL de fichier, donc un nom — pas un blob anonyme."
          }
        }
      }
    },
    "resume.share.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "that is what `ShareLink` already does, plus the preview and adaptation to the item type"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "c'est ce que `ShareLink` fait déjà, avec en plus l'aperçu et l'adaptation au type d'élément"
          }
        }
      }
    },
    "resume.share.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UIActivityViewController"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UIActivityViewController"
          }
        }
      }
    },
    "resume.share.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a `Data` has no name: the system invents one, along the lines of “Document”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "un `Data` n'a pas de nom : le système en invente un, du genre « Document »"
          }
        }
      }
    },
    "resume.share.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing the document's `Data`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les `Data` du document"
          }
        }
      }
    },
    "resume.share.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the résumé under its real file name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmet le CV sous son vrai nom de fichier."
          }
        }
      }
    },
    "resume.share.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`ShareLink` whenever sharing something `Transferable` — a URL, an image, some text. Drop to `UIActivityViewController` only for custom activities, which are rare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`ShareLink` dès qu'on partage quelque chose de `Transferable` — une URL, une image, un texte. Descendre à `UIActivityViewController` seulement pour des activités personnalisées, qui sont rares."
          }
        }
      }
    }
  },
  "version": "1.0"
}
