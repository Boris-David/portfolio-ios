{
  "sourceLanguage": "fr",
  "strings": {
    "settings.confirmation.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad it renders as a popover anchored to its source: with no identifiable source it appears centred, and nobody knows what it refers to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPad il se rend en popover ancré à la source : sans source identifiable, il apparaît au centre et on ne sait plus ce qu'il concerne."
          }
        }
      }
    },
    "settings.confirmation.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`alert` and `confirmationDialog` do not say the same thing. An **alert** interrupts for a choice that cannot be undone; a **confirmation dialog** offers options, rises from the button that triggered it, and dismisses with a swipe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`alert` et `confirmationDialog` ne disent pas la même chose. Une **alerte** interrompt pour un choix qu'on ne pourra pas défaire ; un **dialogue de confirmation** propose des options, monte depuis le bouton qui l'a déclenché, et se referme d'un geste vers le bas."
          }
        }
      }
    },
    "settings.confirmation.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetting three preferences is undone in three gestures. An alert for that teaches the reader to dismiss them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser trois préférences se défait en trois gestes. Une alerte pour ça apprend au lecteur à les ignorer."
          }
        }
      }
    },
    "settings.confirmation.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An `alert`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une `alert`"
          }
        }
      }
    },
    "settings.confirmation.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A destructive button reached by accident has to be catchable before, not after."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton destructif atteint par erreur doit pouvoir être rattrapé avant, pas après."
          }
        }
      }
    },
    "settings.confirmation.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmation at all"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune confirmation"
          }
        }
      }
    },
    "settings.confirmation.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks before putting the settings back to their defaults."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande confirmation avant de remettre les réglages à zéro."
          }
        }
      }
    },
    "settings.confirmation.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A choice between several options, or a reversible destructive action. Past three buttons, it is a screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix entre plusieurs options, ou une action destructive réversible. Au-delà de trois boutons, c'est un écran."
          }
        }
      }
    },
    "settings.form.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`Form` applies its own insets: putting an already-padded container inside produces an offset you then hunt in the wrong file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`Form` applique ses propres marges : y poser un conteneur déjà espacé produit un décalage qu'on cherche ensuite dans le mauvais fichier."
          }
        }
      }
    },
    "settings.form.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A settings screen that does not look like the system's makes the reader work for nothing. `Form` brings the grouping, the insets, the separator inset, keyboard avoidance and the Dynamic Type behaviour — all details otherwise re-derived by eye and got subtly wrong."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran de réglages qui ne ressemble pas à celui d'iOS fait travailler le lecteur pour rien. `Form` apporte le regroupement, les marges, le retrait des séparateurs, l'évitement du clavier et le comportement en Dynamic Type — autant de détails qu'on redérive à l'œil et qu'on rate subtilement."
          }
        }
      }
    },
    "settings.form.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You then rebuild headers, footers and insets — and they drift with every iOS release."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut alors refaire les en-têtes, les bas de section et les marges — et ils dérivent à chaque version d'iOS."
          }
        }
      }
    },
    "settings.form.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A `List` with hand-built rows"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une `List` et des lignes maison"
          }
        }
      }
    },
    "settings.form.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab is a content destination. Settings open, change one thing, and close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet est une destination de contenu. Les réglages s'ouvrent, se changent, se referment."
          }
        }
      }
    },
    "settings.form.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fifth tab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cinquième onglet"
          }
        }
      }
    },
    "settings.form.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives this screen the shape of the system's own Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne à cet écran la forme des Réglages du système."
          }
        }
      }
    },
    "settings.form.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever a screen is a list of preferences. Not for free-form layout, where `Form` imposes its structure."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès qu'un écran est une liste de préférences. Pas pour de la mise en page libre, où `Form` impose sa structure."
          }
        }
      }
    },
    "settings.picker.pitfall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It **caps its own font**: at the accessibility sizes the whole screen grows and this stays small. That is not a defect — it is what keeps the three options on one line — but it shows, and it means a segmented control cannot carry a label somebody needs to read large.\n\nVerified in a capture at `accessibility-extra-extra-extra-large`. This note previously claimed the labels “overlap”: that was wrong, and written before anybody looked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il **plafonne sa police** : aux tailles d'accessibilité, tout l'écran grossit et lui reste petit. Ce n'est pas un défaut — c'est ce qui garde les trois options sur une ligne — mais ça se voit, et ça veut dire qu'un segmenté ne peut pas porter un libellé qu'on a besoin de lire en grand.\n\nVérifié en capture à `accessibility-extra-extra-extra-large`. La note disait auparavant qu'ils « se chevauchent » : c'était faux, et écrit avant d'avoir regardé."
          }
        }
      }
    },
    "settings.picker.rationale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A segmented control earns its place at **three short, mutually exclusive choices**: everything is legible at a glance, and choosing takes one gesture. Past four, the labels truncate and the control becomes a guessing game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segmenté se justifie à **trois choix courts et mutuellement exclusifs** : tout est lisible d'un coup d'œil, et le choix se fait en un geste. Au-delà de quatre, les libellés se tronquent et le contrôle devient une devinette."
          }
        }
      }
    },
    "settings.picker.rejected.1.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It hides the options: you only learn what you can choose after tapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cache les options : on ne sait ce qu'on peut choisir qu'après avoir tapé."
          }
        }
      }
    },
    "settings.picker.rejected.1.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pull-down `Menu`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un `Menu` déroulant"
          }
        }
      }
    },
    "settings.picker.rejected.2.because": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two states cannot express “follow the device”, which is the default and a value in its own right."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux états ne peuvent pas exprimer « suivre l'appareil », qui est le défaut et une valeur à part entière."
          }
        }
      }
    },
    "settings.picker.rejected.2.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light/dark `Toggle`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un `Toggle` clair/sombre"
          }
        }
      }
    },
    "settings.picker.role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three appearances, all visible, one chosen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois apparences, toutes visibles, une seule choisie."
          }
        }
      }
    },
    "settings.picker.whenToUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two to four short options you want all visible. Language, just below, uses a list instead: its labels are language names, and they grow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux à quatre options courtes qu'on veut toutes montrer. La langue, juste en dessous, emploie une liste : les libellés y sont des noms de langues, et ils s'allongent."
          }
        }
      }
    }
  },
  "version": "1.0"
}
