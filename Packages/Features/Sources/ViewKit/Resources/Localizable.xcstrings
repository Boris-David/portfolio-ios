    "interface.dependenciesRule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule: *a dependency earns its place by what would be worse without it, not by what it makes convenient.*"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle : *une dépendance se justifie par ce qui serait pire sans elle, pas par ce qu'elle rend pratique.*"
          }
        }
      }
    },
