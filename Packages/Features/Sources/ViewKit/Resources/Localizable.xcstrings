    "interface.engineeringIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decisions, what they ruled out, and the traps they avoid. Turn on annotations to see, screen by screen, what each component does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décisions, ce qu'elles ont écarté, et les pièges qu'elles évitent. Activez les annotations pour voir, écran par écran, quel composant fait quoi."
          }
        }
      }
    },
