    "interface.architecture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The architecture"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'architecture"
          }
        }
      }
    },
    "interface.architectureIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every layer is an SPM package — except the composition root, which is the application target. A missing dependency is not a convention, it is an `import` that does not resolve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque couche est un package SPM — sauf la racine de composition, qui est la cible de l'application. Une dépendance absente n'est pas une convention, c'est un `import` qui ne résout pas."
          }
        }
      }
    },
    "interface.architecturePatterns": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architecture patterns"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les motifs d'architecture"
          }
        }
      }
    },
    "interface.architecturePatternsSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each pattern separates, what it costs, and where it breaks — then the codebases read against them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que chaque motif sépare, ce qu'il coûte, et où il casse — puis les bases de code lues à travers eux."
          }
        }
      }
    },
